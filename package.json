{
  "name": "convertios-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted conversion backend for Convertios",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "test": "node --test tests/server.test.js && node tests/site-check.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "stamp": "python3 scripts/stamp-assets.py"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  }
}
